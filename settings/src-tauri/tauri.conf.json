{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HashOverlay Settings",
  "version": "1.0.0",
  "identifier": "dev.hashoverlay.settings",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HashOverlay Settings",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../target/release/hashoverlay.exe": "hashoverlay.exe",
      "../../README.md": "README.md",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../docs/usage.md": "docs/usage.md",
      "../../docs/widgets.md": "docs/widgets.md"
    }
  }
}
