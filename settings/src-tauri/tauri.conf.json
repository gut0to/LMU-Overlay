{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HashOverlay Settings",
  "version": "0.1.0",
  "identifier": "dev.hashoverlay.settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HashOverlay Settings",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
